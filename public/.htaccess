# =====================================================================
# Identifine Hybrid Routing: React Frontend + WordPress REST API / Admin
# =====================================================================

DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Real WordPress directories — pass through directly
  RewriteRule ^wp-admin($|/) - [L]
  RewriteRule ^wp-content/ - [L]
  RewriteRule ^wp-includes/ - [L]

  # 2. WordPress PHP files — pass through directly
  RewriteRule ^wp-login\.php - [L]
  RewriteRule ^wp-cron\.php - [L]
  RewriteRule ^xmlrpc\.php - [L]
  RewriteRule ^wp-.*\.php$ - [L]

  # 3. Custom cPanel folders
  RewriteRule ^(admin|apps|\.well-known)($|/) - [L]

  # 4. Serve physical files and folders directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 5. WordPress REST API → route to WordPress index.php (NOT React)
  RewriteRule ^wp-json/ /index.php [L]

  # 6. All other routes → React SPA
  RewriteRule . /index.html [L]
</IfModule>
