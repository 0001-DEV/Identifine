# =====================================================================
# Identifine Hybrid Routing: React Frontend + WordPress REST API / Admin
# =====================================================================

DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Allow direct access to WordPress Admin, login, and REST API
  RewriteRule ^wp-admin($|/) - [L]
  RewriteRule ^wp-json/ - [L]
  RewriteRule ^wp-login\.php - [L]
  RewriteRule ^xmlrpc\.php - [L]

  # 2. Allow direct access to WordPress Content & Uploads (images, plugins, themes)
  RewriteRule ^wp-content/ - [L]
  RewriteRule ^wp-includes/ - [L]

  # 3. Allow direct access to custom cPanel subdirectories
  RewriteRule ^(admin|apps|\.well-known)($|/) - [L]

  # 4. Route all existing physical files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 6. Route all single-page app (React) visitor URLs to index.html
  RewriteRule . /index.html [L]
</IfModule>
